<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permiso necesario para realizar peticiones HTTP a la API pública de wger -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrainUpApp">

        <!-- Activity de inicio: WelcomeActivity muestra el logo, título, descripción
             y beneficios con botón para continuar al onboarding. -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actividades del onboarding -->
        <activity android:name=".ui.IntroActivity" android:exported="false" />
        <activity android:name=".ui.PersonalDataActivity" android:exported="false" />
        <activity android:name=".ui.FitnessDataActivity" android:exported="false" />
        <activity android:name=".ui.EquipmentActivity" android:exported="false" />
        <activity android:name=".ui.InjuriesActivity" android:exported="false" />
        <activity android:name=".ui.PreferencesActivity" android:exported="false" />

        <!-- MainActivity (mockup principal con BottomNavigation) -->
        <activity android:name=".ui.MainActivity" android:exported="false" />

        <!-- Splash y Select Exercise Activities -->
        <activity android:name=".ui.SplashActivity" android:exported="false" />
        <activity android:name=".ui.SelectExerciseActivity" android:exported="false" />

    </application>

</manifest>