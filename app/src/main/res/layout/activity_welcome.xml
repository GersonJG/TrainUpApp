<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcome_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".WelcomeActivity">

    <!-- Título principal: TrainUP -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/welcome_title"
        android:textStyle="bold"
        android:textSize="28sp"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_goneMarginTop="24dp"
        app:layout_constraintVertical_bias="0"/>

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/welcome_subtitle"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="16sp"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"/>

    <!-- Logo centrado -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/logo_content_desc"
        app:tint="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Descripción -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/welcome_description"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="16sp"
        android:lineSpacingExtra="4sp"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Beneficios con icono Material al inicio -->
    <TextView
        android:id="@+id/tvBenefit1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/benefit_1"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:drawableStartCompat="@drawable/ic_fitness_center_24"
        android:drawablePadding="8dp"
        app:drawableTint="?attr/colorPrimary"
        app:layout_constraintTop_toBottomOf="@id/tvDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tvBenefit2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/benefit_2"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:drawableStartCompat="@drawable/ic_psychology_24"
        android:drawablePadding="8dp"
        app:drawableTint="?attr/colorPrimary"
        app:layout_constraintTop_toBottomOf="@id/tvBenefit1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tvBenefit3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/benefit_3"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:drawableStartCompat="@drawable/ic_trending_up_24"
        android:drawablePadding="8dp"
        app:drawableTint="?attr/colorPrimary"
        app:layout_constraintTop_toBottomOf="@id/tvBenefit2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Botón de acción inferior: Continuar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStart"
        style="@style/TrainUp.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/button_continue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
